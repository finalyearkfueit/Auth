{
  "info": {
    "_postman_id": "password-reset-collection",
    "name": "AI Studio - Password Reset API",
    "description": "Complete password reset workflow with beautiful email templates",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Password Reset",
      "item": [
        {
          "name": "1. Request Password Reset",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.environment.set('password_reset_status', 'OTP Sent Successfully');",
                  "    pm.test('OTP sent to email', function () {",
                  "        pm.expect(pm.response.json().success).to.be.true;",
                  "        pm.expect(pm.response.json().message).to.include('OTP sent');",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"test@example.com\"}"
            },
            "url": {
              "raw": "http://localhost:8000/api/accounts/forgot-password/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "accounts", "forgot-password", ""]
            },
            "description": "Step 1: User requests password reset by providing their email address.\n\nResponse includes a message confirming OTP has been sent to their email.\n\n⏱️ OTP Expiry: 10 minutes"
          },
          "response": [
            {
              "name": "Success - OTP Sent",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\"email\": \"user@example.com\"}"
                },
                "url": {
                  "raw": "http://localhost:8000/api/accounts/forgot-password/",
                  "protocol": "http",
                  "host": ["localhost"],
                  "port": "8000",
                  "path": ["api", "accounts", "forgot-password", ""]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n    \"success\": true,\n    \"message\": \"OTP sent to your email. Please check your inbox.\",\n    \"data\": null,\n    \"timestamp\": \"2024-01-15T10:30:00Z\"\n}"
            },
            {
              "name": "Error - User Not Found",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\"email\": \"nonexistent@example.com\"}"
                },
                "url": {
                  "raw": "http://localhost:8000/api/accounts/forgot-password/",
                  "protocol": "http",
                  "host": ["localhost"],
                  "port": "8000",
                  "path": ["api", "accounts", "forgot-password", ""]
                }
              },
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n    \"success\": false,\n    \"message\": {\n        \"email\": [\"User with this email does not exist.\"]\n    },\n    \"timestamp\": \"2024-01-15T10:30:00Z\"\n}"
            }
          ]
        },
        {
          "name": "2. Verify OTP Code",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const resetToken = pm.response.json().data.reset_token;",
                  "    pm.environment.set('reset_token', resetToken);",
                  "    pm.test('OTP verified & reset token received', function () {",
                  "        pm.expect(pm.response.json().success).to.be.true;",
                  "        pm.expect(pm.response.json().data.reset_token).to.exist;",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"test@example.com\", \"otp_code\": \"123456\"}"
            },
            "url": {
              "raw": "http://localhost:8000/api/accounts/verify-otp/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "accounts", "verify-otp", ""]
            },
            "description": "Step 2: User verifies the OTP code received in their email.\n\nResponse includes the reset_token needed for password reset.\n\n✓ OTP must be 6 digits\n✓ OTP must not be expired"
          },
          "response": [
            {
              "name": "Success - OTP Verified",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\"email\": \"user@example.com\", \"otp_code\": \"123456\"}"
                },
                "url": {
                  "raw": "http://localhost:8000/api/accounts/verify-otp/",
                  "protocol": "http",
                  "host": ["localhost"],
                  "port": "8000",
                  "path": ["api", "accounts", "verify-otp", ""]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n    \"success\": true,\n    \"message\": \"OTP verified successfully.\",\n    \"data\": {\n        \"reset_token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJlbWFpbCI6InRlc3RAZXhhbXBsZS5jb20iLCJ0eXBlIjoicGFzc3dvcmRfcmVzZXQiLCJleHAiOjE3MDU0NDQyNjAsImlhdCI6IDE3MDU0NDMyNjB9.abcdef...\"\n    },\n    \"timestamp\": \"2024-01-15T10:31:00Z\"\n}\n"
            },
            {
              "name": "Error - Invalid OTP",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\"email\": \"user@example.com\", \"otp_code\": \"000000\"}"
                },
                "url": {
                  "raw": "http://localhost:8000/api/accounts/verify-otp/",
                  "protocol": "http",
                  "host": ["localhost"],
                  "port": "8000",
                  "path": ["api", "accounts", "verify-otp", ""]
                }
              },
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n    \"success\": false,\n    \"message\": \"Invalid OTP.\",\n    \"timestamp\": \"2024-01-15T10:31:00Z\"\n}"
            }
          ]
        },
        {
          "name": "3. Reset Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.test('Password reset successfully', function () {",
                  "        pm.expect(pm.response.json().success).to.be.true;",
                  "        pm.expect(pm.response.json().message).to.include('Password reset successfully');",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"reset_token\": \"{{reset_token}}\", \"password\": \"NewPass123!@\", \"password_confirm\": \"NewPass123!@\"}"
            },
            "url": {
              "raw": "http://localhost:8000/api/accounts/reset-password/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "accounts", "reset-password", ""]
            },
            "description": "Step 3: User submits their new password with the reset token.\n\n⏱️ Token Expiry: 15 minutes\n\nPassword Requirements:\n✓ Minimum 8 characters\n✓ Uppercase letters (A-Z)\n✓ Lowercase letters (a-z)\n✓ Digits (0-9)\n✓ Special characters (!@#$%^&*)"
          },
          "response": [
            {
              "name": "Success - Password Reset",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\"reset_token\": \"eyJhbGciOiJIUzI1NiIs...\", \"password\": \"NewPass123!@\", \"password_confirm\": \"NewPass123!@\"}"
                },
                "url": {
                  "raw": "http://localhost:8000/api/accounts/reset-password/",
                  "protocol": "http",
                  "host": ["localhost"],
                  "port": "8000",
                  "path": ["api", "accounts", "reset-password", ""]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n    \"success\": true,\n    \"message\": \"Password reset successfully.\",\n    \"data\": null,\n    \"timestamp\": \"2024-01-15T10:32:00Z\"\n}"
            },
            {
              "name": "Error - Expired Token",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\"reset_token\": \"expired_token_here\", \"password\": \"NewPass123!@\", \"password_confirm\": \"NewPass123!@\"}"
