    {
      "name": "🟥 GOOGLE LOGIN ⭐ NEW",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (pm.response.code === 200 || pm.response.code === 201) {",
              "    pm.environment.set('google_access_token', jsonData.data.access);",
              "    pm.test('Google login successful', () => pm.expect(jsonData.status).to.equal('success'));",
              "}",
              "pm.test('Valid response code', () => pm.expect([200, 201]).to.include(pm.response.code));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_token\": \"YOUR_GOOGLE_ID_TOKEN_HERE\"\n}"
        },
        "description": "⚠️ Replace YOUR_GOOGLE_ID_TOKEN_HERE with actual Google token from:\n1. Google OAuth Playground: https://developers.google.com/oauthplayground/\n2. Or use: https://accounts.google.com/o/oauth2/v2/auth?client_id=YOUR_CLIENT_ID&response_type=id_token&scope=openid+email+profile"
      },
      "url": {
        "raw": "http://localhost:8000/api/auth/google-login/",
        "protocol": "http",
        "host": ["localhost"],
        "port": "8000",
        "path": ["api", "auth", "google-login", ""]
      }
