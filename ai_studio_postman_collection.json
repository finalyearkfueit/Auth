  "item": [
    {
      "name": "1️⃣ REGISTER USER",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (pm.response.code === 201) {",
              "    pm.environment.set('access_token', jsonData.data.access);",
              "    pm.environment.set('refresh_token', jsonData.data.refresh);",
              "    pm.environment.set('user_id', jsonData.data.user.id);",
              "    pm.environment.set('user_email', jsonData.data.user.email);",
              "}",
              "pm.test('Status code 201', () => pm.expect(pm.response.code).to.equal(201));",
              "pm.test('Response has access token', () => pm.expect(jsonData.data.access).to.exist);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"testuser@gmail.com\",\n  \"password\": \"SecurePassword@123\",\n  \"confirm_password\": \"SecurePassword@123\"\n}"
        },
        "url": {
          "raw": "http://localhost:8000/api/auth/register/",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["api", "auth", "register", ""]
        }
      }
    },
